pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/utils/cryptography/MerkleProof.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

/**
 * @title AetherMerkleDistributor
 * @notice Enterprise Multi-Season Merkle Distributor for AetherZone Syndicate Rewards
 * @dev Supports Native SHIDO and any ERC-20 token rewards (ILCFBR, USDC, CHINA, CWK).
 * Implements double-claim protection, cryptographic verification, and time-locked sweep safety.
 */
contract AetherMerkleDistributor is Ownable, ReentrancyGuard {
    using SafeERC20 for IERC20;

    struct Season {
        string title;
        address token; // address(0) for native SHIDO, otherwise ERC-20 address
        bytes32 merkleRoot;
        uint256 totalRewardAmount;
        uint256 totalClaimedAmount;
        uint256 claimDeadline;
        bool isFinalized;
    }

    // Season ID -> Season Metadata
    mapping(uint256 => Season) public seasons;

    // Season ID -> User Address -> Claim Status
    mapping(uint256 => mapping(address => bool)) public hasClaimed;

    // Events
    event SeasonConfigured(
        uint256 indexed seasonId,
        string title,
        address indexed token,
        bytes32 merkleRoot,
        uint256 totalRewardAmount,
        uint256 claimDeadline
    );
    event RewardClaimed(
        uint256 indexed seasonId,
        address indexed recipient,
        address token,
        uint256 amount
    );
    event UnclaimedSwept(
        uint256 indexed seasonId,
        address indexed sweepRecipient,
        address token,
        uint256 sweptAmount
    );

    error SeasonNotFinalized();
    error ClaimPeriodExpired();
    error AlreadyClaimed();
    error InvalidMerkleProof();
    error TransferFailed();
    error ClaimPeriodNotEnded();
    error InvalidAddress();
    error ZeroAmount();

    constructor(address initialOwner) Ownable(initialOwner) {}

    /**
     * @notice Configure and open a season for Merkle reward claiming
     * @param seasonId Unique numeric ID for the season (e.g. 1, 2, 3)
     * @param title Title of the season (e.g. "Syndicate Season 02")
     * @param token Address of reward token (address(0) for native SHIDO)
     * @param merkleRoot Cryptographic Merkle Root generated by backend snapshot
     * @param totalRewardAmount Total tokens allocated for this season
     * @param durationSeconds Duration of claiming window (e.g. 90 days = 7776000)
     */
    function configureSeason(
        uint256 seasonId,
        string calldata title,
        address token,
        bytes32 merkleRoot,
        uint256 totalRewardAmount,
        uint256 durationSeconds
    ) external payable onlyOwner {
        if (merkleRoot == bytes32(0)) revert InvalidMerkleProof();
        if (totalRewardAmount == 0) revert ZeroAmount();

        uint256 deadline = block.timestamp + durationSeconds;

        seasons[seasonId] = Season({
            title: title,
            token: token,
            merkleRoot: merkleRoot,
            totalRewardAmount: totalRewardAmount,
            totalClaimedAmount: 0,
            claimDeadline: deadline,
            isFinalized: true
        });

        // If native SHIDO is passed with configuration, verify amount
        if (token == address(0)) {
            require(msg.value >= totalRewardAmount, "Insufficient native SHIDO sent");
        } else {
            // Transfer ERC-20 reward tokens into this contract from caller
            IERC20(token).safeTransferFrom(msg.sender, address(this), totalRewardAmount);
        }

        emit SeasonConfigured(
            seasonId,
            title,
            token,
            merkleRoot,
            totalRewardAmount,
            deadline
        );
    }

    /**
     * @notice Claim rewards for caller using cryptographic Merkle Proof
     * @param seasonId Season ID to claim from
     * @param amount Exact token reward allocated to msg.sender
     * @param merkleProof Array of sibling hashes forming the Merkle Proof
     */
    function claim(
        uint256 seasonId,
        uint256 amount,
        bytes32[] calldata merkleProof
    ) external nonReentrant {
        _executeClaim(seasonId, msg.sender, amount, merkleProof);
    }

    /**
     * @notice Claim rewards on behalf of a recipient (tokens sent strictly to recipient)
     * @param seasonId Season ID to claim from
     * @param recipient The eligible wallet address
     * @param amount Exact token reward allocated to recipient
     * @param merkleProof Array of sibling hashes forming the Merkle Proof
     */
    function claimFor(
        uint256 seasonId,
        address recipient,
        uint256 amount,
        bytes32[] calldata merkleProof
    ) external nonReentrant {
        if (recipient == address(0)) revert InvalidAddress();
        _executeClaim(seasonId, recipient, amount, merkleProof);
    }

    /**
     * @dev Internal execution logic for claim verification and payout
     */
    function _executeClaim(
        uint256 seasonId,
        address recipient,
        uint256 amount,
        bytes32[] calldata merkleProof
    ) internal {
        Season storage season = seasons[seasonId];

        if (!season.isFinalized) revert SeasonNotFinalized();
        if (block.timestamp > season.claimDeadline) revert ClaimPeriodExpired();
        if (hasClaimed[seasonId][recipient]) revert AlreadyClaimed();
        if (amount == 0) revert ZeroAmount();

        // Standard OpenZeppelin Double-Hash Leaf formatting:
        // leaf = keccak256(bytes.concat(keccak256(abi.encode(recipient, amount))))
        bytes32 leaf = keccak256(bytes.concat(keccak256(abi.encode(recipient, amount))));

        if (!MerkleProof.verify(merkleProof, season.merkleRoot, leaf)) {
            revert InvalidMerkleProof();
        }

        hasClaimed[seasonId][recipient] = true;
        season.totalClaimedAmount += amount;

        // Disburse tokens
        if (season.token == address(0)) {
            (bool success, ) = recipient.call{value: amount}("");
            if (!success) revert TransferFailed();
        } else {
            IERC20(season.token).safeTransfer(recipient, amount);
        }

        emit RewardClaimed(seasonId, recipient, season.token, amount);
    }

    /**
     * @notice Verify if a user is eligible without executing a transaction
     */
    function isClaimable(
        uint256 seasonId,
        address recipient,
        uint256 amount,
        bytes32[] calldata merkleProof
    ) external view returns (bool) {
        Season storage season = seasons[seasonId];
        if (!season.isFinalized || block.timestamp > season.claimDeadline || hasClaimed[seasonId][recipient]) {
            return false;
        }
        bytes32 leaf = keccak256(bytes.concat(keccak256(abi.encode(recipient, amount))));
        return MerkleProof.verify(merkleProof, season.merkleRoot, leaf);
    }

    /**
     * @notice Sweep unclaimed tokens back to treasury after claim window has passed
     * @param seasonId Season ID to sweep
     * @param sweepRecipient Address to receive unclaimed dust
     */
    function sweepUnclaimed(
        uint256 seasonId,
        address sweepRecipient
    ) external onlyOwner nonReentrant {
        if (sweepRecipient == address(0)) revert InvalidAddress();
        Season storage season = seasons[seasonId];

        if (!season.isFinalized) revert SeasonNotFinalized();
        if (block.timestamp <= season.claimDeadline) revert ClaimPeriodNotEnded();

        uint256 remaining = season.totalRewardAmount > season.totalClaimedAmount 
            ? season.totalRewardAmount - season.totalClaimedAmount 
            : 0;

        if (remaining > 0) {
            season.totalClaimedAmount = season.totalRewardAmount; // prevent re-sweep

            if (season.token == address(0)) {
                (bool success, ) = sweepRecipient.call{value: remaining}("");
                if (!success) revert TransferFailed();
            } else {
                IERC20(season.token).safeTransfer(sweepRecipient, remaining);
            }

            emit UnclaimedSwept(seasonId, sweepRecipient, season.token, remaining);
        }
    }

    // Fallback to receive native SHIDO
    receive() external payable {}
}
